server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  # O default do nginx é 1 MB. A importação de contatos sobe o CSV como arquivo, e o
  # produto suporta listas de até ~1 milhão de contatos (~100 MB) — sem isto o nginx
  # responde 413 em HTML antes da requisição chegar ao backend. Fica um pouco acima do
  # teto do multer (IMPORT_MAX_MB, 100 por padrão) para que o excesso real seja
  # recusado lá, com JSON de erro em vez de página de erro do nginx.
  client_max_body_size 110m;

  # DNS interno do Docker. Necessário porque o destino do proxy é uma variável:
  # assim o nome é resolvido a CADA requisição, não uma vez no start.
  # Sem isso, dois problemas reais: o nginx não sobe se o backend ainda não existe,
  # e continua usando o IP antigo depois que o backend é redeployado (502 até reiniciar).
  resolver 127.0.0.11 ipv6=off valid=10s;

  # Gzip
  gzip on;
  gzip_min_length 1024;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml application/font-woff font/woff2;

  # A API e os uploads são servidos pelo backend no mesmo host — em produção o
  # frontend usa apiUrl '/api', então o proxy abaixo evita CORS e cookies cross-site.
  #
  # BACKEND_UPSTREAM vem do ambiente (default no Dockerfile): "backend:3000" dentro de
  # um stack Compose, ou o hostname interno do serviço quando são Apps separados.
  location /api/ {
    set $upstream "${BACKEND_UPSTREAM}";
    proxy_pass http://$upstream$request_uri;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 1h;

    # Repassa o upload conforme ele chega, em vez de gravar os 100 MB inteiros num
    # arquivo temporário do nginx antes de encostar no backend. Corta o tempo até o
    # job ser criado e evita uma segunda cópia do arquivo em disco.
    proxy_request_buffering off;
  }

  location /uploads/ {
    set $upstream "${BACKEND_UPSTREAM}";
    proxy_pass http://$upstream$request_uri;
    proxy_set_header Host $host;
  }

  # SPA fallback — todas as rotas Angular caem no index.html
  location / {
    try_files $uri $uri/ /index.html;
  }

  # Cache imutável de assets com hash
  location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  # index.html nunca em cache (controla as versões dos assets)
  location = /index.html {
    add_header Cache-Control "no-store, no-cache, must-revalidate";
    expires 0;
  }
}
